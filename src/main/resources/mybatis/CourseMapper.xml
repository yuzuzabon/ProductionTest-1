<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!--  -->
<mapper namespace="com.example.app.mapper.CourseMapper">

<select id="searchAll" resultType="course">
	select
		 * FROM course;
</select>

<insert id="save" >
 insert into course
 	(title,place,capacity,created)
 	values
 	(#{title},#{place},#{capacity},now())
</insert>

<select id="searchById" parameterType="int" resultType="course">
	select
		 * FROM course
		 where course.id=#{id}
</select>

</mapper>